# Einzige fest konfigurierte Datenbank (asy_benutzer, asy_mandanten).
# Alle weiteren Datenbanken werden dynamisch aus asy_mandanten geladen. Benutzer und Passwort URL-kodieren
# (z. B. @ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
DATABASE_URL_AUTH=postgresql://postgres:password@localhost:5432/auth

# Optional: Zugangsdaten weiterer Datenbankserver (JSON). Mandanten verweisen per MANDANT.CREDENTIAL /
# MANDANT.SYSTEM_CREDENTIAL darauf. Ohne Eintrag gelten auf der AUTH-Instanz die Zugangsdaten von DATABASE_URL_AUTH.
# Der Name "default" gilt fuer alle Verbindungen ohne eigenen Verweis. "ssl": true erzwingt eine verschluesselte Verbindung.
# PDVM_DB_CREDENTIALS={"default":{"user":"pdvm","password":"..."},"srv-berlin":{"user":"pdvm","password":"...","ssl":true}}

# Fernet-Schluessel fuer Zugangsdaten, die im System gesetzt werden (Tabelle asy_credentials, z. B. SMTP-Passwort).
# Erzeugen: ..\.venv\Scripts\python.exe -c "from app.core.secret_box import generate_key; print(generate_key())"
# Sicher sichern; ohne den Schluessel sind gespeicherte Passwoerter unlesbar.
PDVM_SECRET_KEY=

# Auth
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (JSON-Array)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: Release-Check (GitHub-Katalog), Format owner/name
# GITHUB_RELEASE_REPO=
# GITHUB_RELEASE_TOKEN=

# Optional: automatisches CREATE DATABASE fuer Mandanten (Standard: false)
# ALLOW_MANDANT_DB_AUTO_CREATE=false

# Optional: Mandant loeschen (Aktion mandant.delete). Ablage der Sicherung vor dem Loeschen (Standard:
# database/backups/mandant_geloescht) und Ordner der PostgreSQL-Client-Werkzeuge pg_dump/pg_restore (Standard: PATH, dann Standardpfade).
# MANDANT_DELETE_BACKUP_DIR=
# PG_BIN_DIR=
