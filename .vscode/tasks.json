{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PDVM: Backend starten",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": { "PYTHONUTF8": "1" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "pdvm-backend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Will watch for changes",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": { "group": "pdvm", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "PDVM: Frontend starten",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "pdvm-frontend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": { "group": "pdvm", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "PDVM: Alles starten",
      "dependsOn": ["PDVM: Backend starten", "PDVM: Frontend starten"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "PDVM: Alles stoppen",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\scripts\\stop_pdvm.ps1",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "PDVM: Datenbanken sichern",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\database\\scripts\\backup_all_databases.ps1",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "PDVM: Tests (Backend)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest",
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": { "PYTHONUTF8": "1" }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "PDVM: Architektur-Guard",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest test_architecture_guard.py",
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": { "PYTHONUTF8": "1" }
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
